  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 90ff606656cc69b44a53dd95dfe299d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  controller: {fileID: 0}
  playOnStart: 1
  voiceAnchor: {fileID: 0}
  rememberAcrossReloads: 1
  minVisibleTime: 1.5
  steps:
  - id: lanterna
    text: Aperte {Flashlight} para ligar a *lanterna*
    after: 
    delay: 1.5
    waitFor: 1
    actions: Flashlight
    signal: 
    amount: 1
    timeout: 0
    skipIfAlreadyDone: 1
    voiceId: 
  - id: mover
    text: Use {Move} para se mover e {Look} para olhar ao redor
    after: 
    delay: 1.5
    waitFor: 2
    actions: Move
    signal: 
    amount: 1.5
    timeout: 0
    skipIfAlreadyDone: 1
    voiceId: 
  - id: agachar
    text: "{Crouch} para *agachar*. Agachado, seus passos quase n\xE3o fazem barulho"
    after: 
    delay: 2
    waitFor: 1
    actions: Crouch
    signal: 
    amount: 1
    timeout: 0
    skipIfAlreadyDone: 1
    voiceId: 
  - id: interagir
    text: Aperte {Interact} para *interagir* com objetos
    after: 
    delay: 2
    waitFor: 1
    actions: Interact
    signal: 
    amount: 1
    timeout: 0
    skipIfAlreadyDone: 1
    voiceId: 
  - id: chave
    text: Procure pela *chave* para abrir a porta
    after: 
    delay: 1
    waitFor: 3
    actions: 
    signal: chave_coletada
    amount: 1
    timeout: 0
    skipIfAlreadyDone: 1
    voiceId: 
  - id: espiar
    text: Segure {PeekLeft} ou {PeekRight} para *espiar* pelas quinas
    after: dialogo_saida
    delay: 1
    waitFor: 2
    actions: PeekLeft, PeekRight
    signal: 
    amount: 0.5
    timeout: 12
    skipIfAlreadyDone: 1
    voiceId: 
  - id: correr
    text: Segure {Sprint} para *correr*
    after: tremor_terminou
    delay: 0.3
    waitFor: 2
    actions: Sprint
    signal: 
    amount: 1
    timeout: 0
    skipIfAlreadyDone: 1
    voiceId: 
