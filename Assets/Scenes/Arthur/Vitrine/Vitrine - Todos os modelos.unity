      m_Extent: {x: 59, y: 3.0178504, z: 52.98751}
    photo: {fileID: 1121494501}
  - version: v7.3.1
    title: Quebrar a ronda fixa (horizonte maior)
    detail: "Map - V8. Ponto pouco visto paga mais e gamma 0.999 (~100 s \xE0 frente).
