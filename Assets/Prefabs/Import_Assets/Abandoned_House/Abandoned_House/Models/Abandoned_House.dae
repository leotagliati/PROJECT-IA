  <library_effects>
    <effect id="Ban-effect">
      <profile_COMMON>
        <newparam sid="Ban_jpg_001-surface">
          <surface type="2D">
            <init_from>Ban_jpg_001</init_from>
          </surface>
        </newparam>
        <newparam sid="Ban_jpg_001-sampler">
          <sampler2D>
            <source>Ban_jpg_001-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
